rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function teacher() {
      return request.auth != null && request.auth.token.email == 'CORREO_DEL_PROFE@gmail.com';
    }

    // Glhea (sin login) solo puede CREAR eventos con forma válida. Nadie puede leerlos salvo el profe.
    match /events/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['type','attempt','practice','ts','section','qnum','prompt','expected','given','ok','retry','voice','score','total'])
        && request.resource.data.type in ['start','answer','done']
        && request.resource.data.attempt is string && request.resource.data.attempt.size() <= 40
        && request.resource.data.practice is string && request.resource.data.practice.size() <= 40
        && request.resource.data.ts is int
        && (!('prompt' in request.resource.data) || request.resource.data.prompt.size() <= 400)
        && (!('given' in request.resource.data) || request.resource.data.given.size() <= 400)
        && (!('expected' in request.resource.data) || request.resource.data.expected.size() <= 400)
        && (!('section' in request.resource.data) || request.resource.data.section.size() <= 200);
      allow read, update, delete: if teacher();
    }

    // Progreso guardado de la práctica. El id incluye una clave larga (studentKey), así que solo
    // quien la conoce puede leer/escribir su documento. No se puede listar ni borrar sin ser el profe.
    match /progress/{id} {
      allow get: if id.size() >= 30;
      allow create, update: if id.size() >= 30
        && request.resource.data.keys().hasOnly(['data','ts'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 6000
        && request.resource.data.ts is int;
      allow list, delete: if teacher();
    }

    match /feedback/{id} {
      allow read, write: if teacher();
    }
  }
}
